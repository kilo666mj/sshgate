# Site-specific example only. Do not install this file unchanged: it replaces
# the host's complete sshd configuration and its algorithms may not suit your
# OpenSSH version or access requirements.
Port 22
Protocol 2

HostKey /etc/ssh/ssh_host_ed25519_key

SyslogFacility AUTHPRIV

AuthorizedKeysFile .ssh/authorized_keys

# Authentication
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
PermitRootLogin prohibit-password
StrictModes yes
PermitUserEnvironment no

# GSSAPI
GSSAPIAuthentication no
GSSAPICleanupCredentials no

UsePAM yes

# Connection limits
LoginGraceTime 30
MaxAuthTries 3
MaxStartups 10:50:15

# Idle timeout
ClientAliveInterval 300
ClientAliveCountMax 2

# Algorithms (PQC-first, ETM-only MACs, no CTR ciphers)
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com

# Misc
X11Forwarding no
PrintMotd no
PrintLastLog yes
UseDNS no

ListenAddress 127.0.0.1

Subsystem sftp internal-sftp
